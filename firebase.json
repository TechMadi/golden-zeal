{
  "hosting": {
    "public": "dist/golden-zeal/browser",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/crm/**",
        "destination": "/crm/index.html"
      },
      {
        "source": "/crm",
        "destination": "/crm/index.html"
      },
      {
        "source": "/**",
        "destination": "/index.csr.html"
      }
    ],
    "redirects": [
      {
        "source": "/cinematic",
        "destination": "/narrative",
        "type": 301
      },
      {
        "source": "/directors{,/**}",
        "destination": "/crew",
        "type": 301
      },
      {
        "source": "/photographers{,/**}",
        "destination": "/crew",
        "type": 301
      }
    ],
    "trailingSlash": false
  }
}
